# Postgres connection (Secret: postgres-credentials in cluster; local-only here)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flaketracker
DB_USER=flaketracker
DB_PASSWORD=changeme

# Ingest auth (Secret: ingest-api-key in cluster)
INGEST_API_KEY=changeme

# Scoring parameters (ConfigMap: flaketracker-config in cluster)
WINDOW_SIZE=30
MIN_SAMPLES=5
BROKEN_STREAK=5
FLAKY_THRESHOLD=0.15
HALF_LIFE_DAYS=7
ANALYZER_INTERVAL=60s

LOG_LEVEL=info
