# Database-per-service: ingest, analyzer and api each own a separate Postgres
# instance. Every service reads the same DB_* variable names, but each one is
# given the values for ITS OWN database (its own k8s Deployment/Job env, or its
# own Compose service). Local defaults when running each DB in Docker:
#
#   service   DB_HOST    DB_PORT  DB_NAME   DB_USER   (Kubernetes DB_HOST)
#   ingest    localhost  5432     ingest    ingest    ingest-db
#   analyzer  localhost  5433     analyzer  analyzer  analyzer-db
#   api       localhost  5434     api       api       api-db
#
# The values below are the ingest service's; swap them when running another service.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ingest
DB_USER=ingest
DB_PASSWORD=ingestdb

# Ingest auth (Secret: ingest-api-key in cluster)
INGEST_API_KEY=ingestkey

# HTTP port each service listens on (overridden per-service in k8s manifests)
PORT=8080

# ingest: the results feed only hands out results at least this old
# (must be >= 2x ingest's 4s insert timeout; see internal/ingest/feed.go)
FEED_LAG=10s

# api: where to reach the other two services, and how long to wait for them
# (INGEST_URL below is shared with the analyzer)
ANALYZER_URL=http://localhost:8081
DOWNSTREAM_TIMEOUT=3s

# analyzer: where to reach ingest's internal API, and how the cycle runs
INGEST_URL=http://localhost:8080
ANALYZER_INTERVAL=15s
FEED_PAGE_SIZE=5000
FEED_MAX_PAGES=50
RESCORE_BATCH=1000

# Scoring parameters (ConfigMap: flaketracker-config in cluster)
WINDOW_SIZE=30
MIN_SAMPLES=5
BROKEN_STREAK=5
FLAKY_THRESHOLD=0.15
HALF_LIFE_DAYS=1.5
EVIDENCE_THRESHOLD=0.5

LOG_LEVEL=info
