# Optional settings for docker-compose.yml. Everything has a working default, so
# you can ignore this file. To change something, copy this file to ".env" in this
# folder (".env" is git-ignored) or export the variable in your shell first.
# Never commit real secrets.

# Database passwords (one per service database; local-only defaults).
INGEST_DB_PASSWORD=ingestdb
ANALYZER_DB_PASSWORD=analyzerdb
API_DB_PASSWORD=apidb

# The key CI must send in the X-API-Key header when posting results to ingest.
INGEST_API_KEY=ingestkey

# How often the analyzer scores tests. 5s keeps the local demo snappy
# (the cloud default is 15s).
ANALYZER_INTERVAL=5s

# Which scoring algorithm the analyzer image is BUILT with: v1 or v2. Used to
# rehearse the rollout:  ANALYZER_ALGORITHM=v2 docker compose up -d --build analyzer
ANALYZER_ALGORITHM=v1

# Build metadata shown in the dashboard footer. Set GIT_SHA to the current
# commit with:  GIT_SHA=$(git rev-parse --short HEAD) docker compose up -d --build
# (left unset, the footer shows "local").
# GIT_SHA=
# VERSION=local
